      "roles": [
        {
          "description": "تمنحك منظومة رسوم ثنائية الأبعاد متناسقة تميّز كل شخصية داخل بطاقة الدور السرية وشاشات الاختيار والمراجعة، مع الحفاظ على الغموض والوضوح على شاشة الهاتف.",
          "id": "character-card-art",
          "label": "رسوم بطاقات الشخصيات"
        },
        {
          "description": "تُظهر لك شخصيات القرويين بلغة بصرية موحّدة تعتمد الأخضر الداكن وتفاصيل مهنية غامضة من دون كشف معلومات إضافية خارج الدور المعروض.",
          "id": "villager-role-visuals",
          "label": "هوية أدوار القرويين"
        },
        {
          "description": "تُظهر لك شخصيات المستذئبين بهوية حمراء داكنة ومهدِّدة ومقروءة، مع تمييز واضح عن بقية الفرق داخل بطاقات الأدوار وشاشات الليل.",
          "id": "werewolf-role-visuals",
          "label": "هوية أدوار المستذئبين"
        },
        {
          "description": "تُظهر لك الشخصيات المحايدة بهوية بنفسجية وذهبية متوازنة تفرّقها عن القرويين والمستذئبين مع الحفاظ على الأسلوب الغامض نفسه.",
          "id": "neutral-role-visuals",
          "label": "هوية الأدوار المحايدة"
        },
        {
          "description": "تمنحك معالجة بصرية بسيطة لشاشات العرض والإخفاء وتسليم الهاتف، بحيث تدعم خصوصية اللاعب الحالي وتمنع التباس الانتقال إلى اللاعب التالي من دون إضافة مشاهد زخرفية.",
          "id": "secret-reveal-treatment",
          "label": "معالجة كشف الدور وتسليم الهاتف"
        },
        {
          "description": "تجعل مراحل الليل والنهار والتصويت والوفاة والحماية والهجوم والنجاة بالمقاومة واضحة لك عبر حالات لونية وتكوينات واجهة متناسقة مع الهوية الداكنة واتجاه RTL.",
          "id": "phase-state-treatment",
          "label": "معالجة حالات الليل والنهار والتصويت"
        }
      ]
    },
